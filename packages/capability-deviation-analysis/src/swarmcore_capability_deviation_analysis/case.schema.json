{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://deviation-analysis/case@1",
  "type": "object",
  "required": ["title", "subject", "period", "asOf", "dimensions"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["subjectId", "subjectType"],
      "properties": {
        "subjectId": {"type": "string", "minLength": 1},
        "subjectType": {"enum": ["project", "contract", "work-package"]},
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "asOf": {"type": "string", "format": "date"},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["TIME", "CONTENT", "COST"]}
    }
  },
  "additionalProperties": true
}
