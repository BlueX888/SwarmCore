{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://invoice-assurance/input@1",
  "type": "object",
  "required": [
    "workItemId",
    "workItemRevisionId",
    "evaluationId",
    "payload",
    "subjects",
    "documents",
    "attachments",
    "attachmentManifestHash",
    "selectionManifestHash",
    "baselineHash",
    "configurationHash",
    "configuration"
  ],
  "properties": {
    "workItemId": {"type": "string", "format": "uuid"},
    "workItemRevisionId": {"type": "string", "format": "uuid"},
    "evaluationId": {"type": "string", "format": "uuid"},
    "payload": {
      "type": "object",
      "required": ["title", "asOf", "currency", "timezone", "verificationMode"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "asOf": {"type": "string", "format": "date"},
        "currency": {"type": "string", "minLength": 1, "default": "CNY"},
        "timezone": {"type": "string", "minLength": 1, "default": "Asia/Shanghai"},
        "verificationMode": {
          "enum": ["AUTHORIZED_CONNECTOR", "HUMAN_ASSISTED"],
          "default": "HUMAN_ASSISTED"
        },
        "supplierRef": {"type": "string", "minLength": 1},
        "contractRef": {"type": "string", "minLength": 1},
        "purchaseOrderRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"},
        "businessSnapshot": {"type": "object"},
        "humanVerification": {"type": "object"},
        "fieldConfirmations": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "additionalProperties": true
    },
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "documents": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object"}},
    "attachments": {"type": "array", "items": {"type": "object"}},
    "attachmentManifestHash": {"type": "string", "minLength": 1},
    "selectionManifestHash": {"type": "string", "minLength": 1},
    "baselineHash": {"type": "string", "minLength": 1},
    "configurationHash": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"}
  },
  "additionalProperties": false
}
