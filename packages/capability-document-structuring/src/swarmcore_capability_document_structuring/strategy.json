{
  "apiVersion": "swarmcore.io/v1",
  "kind": "SwarmStrategy",
  "metadata": {"name": "document-structuring-execute-v1"},
  "spec": {
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": "object"},
    "defaults": {
      "timeout": "PT15M",
      "retryPolicy": {
        "maxAttempts": 3,
        "initialInterval": "PT2S",
        "maximumInterval": "PT2M",
        "backoffCoefficient": 2
      }
    },
    "budget": {
      "maxDuration": "PT60M",
      "maxTokens": 120000,
      "maxCostUsd": 2,
      "maxAgents": 1,
      "maxParallelism": 1,
      "onExhausted": "wait_for_budget_approval"
    },
    "agents": {
      "structurer": {"ref": "agent://document/structurer@1"}
    },
    "graph": {
      "entrypoint": "read-documents",
      "nodes": {
        "read-documents": {
          "type": "tool",
          "tool": "tool://document/read-versions@1",
          "input": {
            "evaluationId": "{{ input.evaluationId }}",
            "documents": "{{ input.documents }}"
          }
        },
        "prepare": {
          "type": "tool",
          "tool": "tool://document/structure-prepare@1",
          "dependsOn": ["read-documents"],
          "input": {
            "documents": "{{ tasks.read-documents.output.content.documents }}"
          }
        },
        "analyze": {
          "type": "agent",
          "agent": "structurer",
          "dependsOn": ["prepare"],
          "input": {
            "_contextMode": "node_only",
            "prepared": "{{ tasks.prepare.output.content }}",
            "configuration": "{{ input.configuration }}"
          }
        },
        "quality-check": {
          "type": "tool",
          "tool": "tool://document/quality-check@1",
          "dependsOn": ["prepare", "analyze"],
          "input": {
            "prepared": "{{ tasks.prepare.output.content }}",
            "analysis": "{{ tasks.analyze.output.content }}"
          }
        },
        "review-router": {
          "type": "router",
          "dependsOn": ["quality-check"],
          "routes": [
            {
              "when": "tasks.quality-check.output.content.reviewRequired == true",
              "target": "manual-review"
            }
          ],
          "default": "auto-continue"
        },
        "manual-review": {
          "type": "approval",
          "dependsOn": ["review-router"],
          "prompt": "存在低置信度、缺失证据、占位符、OCR 或跨格式冲突，请复核结构化结果。",
          "inputSchema": {
            "type": "object",
            "required": ["decision"],
            "properties": {
              "decision": {
                "enum": ["CONFIRM", "CORRECT", "REQUEST_REPROCESS", "REJECT"]
              },
              "reason": {"type": "string"},
              "fieldCorrections": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        },
        "auto-continue": {
          "type": "join",
          "strategy": "all",
          "dependsOn": ["review-router"]
        },
        "publish": {
          "type": "tool",
          "tool": "tool://document/publish@1",
          "dependsOn": ["quality-check", "manual-review", "auto-continue"],
          "input": {
            "evaluationId": "{{ input.evaluationId }}",
            "result": "{{ tasks.quality-check.output.content }}",
            "approval": "{{ tasks.manual-review.output }}"
          }
        }
      },
      "output": {"result": "{{ tasks.quality-check.output.content }}"}
    },
    "$defs": {}
  }
}
