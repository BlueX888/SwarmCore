{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://swarm-calibration/input@1",
  "type": "object",
  "required": [
    "workItemId", "workItemRevisionId", "evaluationId", "payload",
    "attachmentManifestHash", "configuration"
  ],
  "properties": {
    "workItemId": {"type": "string", "format": "uuid"},
    "workItemRevisionId": {"type": "string", "format": "uuid"},
    "evaluationId": {"type": "string", "format": "uuid"},
    "payload": {"$ref": "#/$defs/case"},
    "subjects": {"type": "array", "items": {"type": "object"}},
    "documents": {"type": "array", "items": {"type": "object"}},
    "attachments": {"type": "array", "items": {"type": "object"}},
    "attachmentManifestHash": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["title", "issueUrl", "objective", "acceptanceCriteria", "sandbox"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "issueUrl": {
          "type": "string",
          "pattern": "^https://(?:www\\.)?github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*/?$"
        },
        "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxDurationSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
            "maxCostUsd": {"type": "number", "exclusiveMinimum": 0, "maximum": 25},
            "maxTokens": {"type": "integer", "minimum": 1000, "maximum": 1000000}
          },
          "additionalProperties": false
        },
        "sandbox": {
          "type": "object",
          "required": ["enabled", "testCommand"],
          "properties": {
            "enabled": {"type": "boolean"},
            "testCommand": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
