{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://deviation-analysis/result@1",
  "type": "object",
  "required": [
    "schemaVersion", "title", "assessment", "subject", "period", "asOf",
    "qualityStatus", "reviewRequired", "coverage", "time", "content", "cost",
    "dimensions", "rootCauses", "responsibility", "trends", "findings",
    "actions", "evidence", "qualityFlags", "evidenceReview", "narrative",
    "provenance", "artifacts"
  ],
  "properties": {
    "schemaVersion": {"const": "schema://deviation-analysis/result@1"},
    "title": {"type": "string", "minLength": 1},
    "assessment": {
      "type": "object",
      "required": ["subjectId", "periodStart", "periodEnd", "asOf", "baselineHash", "selectionManifestHash"],
      "properties": {
        "subjectId": {"type": ["string", "null"]},
        "periodStart": {"type": ["string", "null"]},
        "periodEnd": {"type": ["string", "null"]},
        "asOf": {"type": ["string", "null"]},
        "baselineHash": {"type": ["string", "null"]},
        "selectionManifestHash": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "subject": {"type": "object"},
    "period": {"type": "object"},
    "asOf": {"type": ["string", "null"]},
    "qualityStatus": {"enum": ["READY", "REVIEW_REQUIRED", "BLOCKED"]},
    "reviewRequired": {"type": "boolean"},
    "coverage": {"type": "object"},
    "time": {"$ref": "#/$defs/dimension"},
    "content": {"$ref": "#/$defs/dimension"},
    "cost": {"$ref": "#/$defs/dimension"},
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["TIME", "CONTENT", "COST"]},
      "additionalProperties": {"$ref": "#/$defs/dimension"}
    },
    "rootCauses": {"type": "array", "items": {"type": "object"}},
    "trends": {"type": "object"},
    "responsibility": {
      "type": "object",
      "required": ["status", "proposals", "decisions", "humanConfirmationRequired"],
      "properties": {
        "status": {"enum": ["NO_PROPOSAL", "PENDING_CONFIRMATION", "CONFIRMED", "DISPUTED"]},
        "humanConfirmationRequired": {"type": "boolean"},
        "proposals": {
          "type": "array",
          "items": {"$ref": "#/$defs/responsibilityItem"}
        },
        "decisions": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "additionalProperties": false
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "qualityFlags": {"type": "array", "items": {"type": "object"}},
    "evidenceReview": {"type": "object"},
    "narrative": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["documentContentHash", "attachmentManifestHash", "selectionManifestHash", "baselineHash", "configurationHash", "agents"],
      "properties": {
        "documentContentHash": {"type": "string"},
        "attachmentManifestHash": {"type": "string"},
        "selectionManifestHash": {"type": "string"},
        "baselineHash": {"type": "string"},
        "configurationHash": {"type": "string"},
        "agents": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "artifacts": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["status", "metrics", "reasons", "evidenceRefs"],
      "properties": {
        "status": {"enum": ["OK", "DATA_INSUFFICIENT", "CONFLICTED", "NOT_APPLICABLE"]},
        "metrics": {"type": "object"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "responsibilityItem": {
      "type": "object",
      "required": ["proposalId", "party", "scope", "rationale", "confidence", "evidenceRefs", "status"],
      "properties": {
        "proposalId": {"type": "string"},
        "party": {"type": "string"},
        "scope": {"type": "string"},
        "rationale": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["PROPOSED", "CONFIRMED", "DISPUTED"]}
      },
      "additionalProperties": false
    }
  }
}
