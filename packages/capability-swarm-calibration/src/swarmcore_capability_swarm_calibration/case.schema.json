{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://swarm-calibration/case@1",
  "type": "object",
  "required": ["title", "issueUrl", "objective", "acceptanceCriteria", "sandbox"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "issueUrl": {
      "type": "string",
      "pattern": "^https://(?:www\\.)?github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*/?$"
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxDurationSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "maxCostUsd": {"type": "number", "exclusiveMinimum": 0, "maximum": 25},
        "maxTokens": {"type": "integer", "minimum": 1000, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "required": ["enabled", "testCommand"],
      "properties": {
        "enabled": {"type": "boolean"},
        "testCommand": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
