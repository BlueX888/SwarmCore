SWARMCORE_DATABASE_URL=postgresql+asyncpg://swarmcore:swarmcore@localhost:5433/swarmcore
SWARMCORE_TEMPORAL_ADDRESS=localhost:7233
SWARMCORE_TEMPORAL_NAMESPACE=default
SWARMCORE_SSE_MAX_CONNECTIONS_PER_ACTOR=5
SWARMCORE_SSE_MAX_CONNECTIONS_PER_PROJECT=100
SWARMCORE_SSE_MAX_LIFETIME_SECONDS=3600
SWARMCORE_TEMPORAL_TASK_QUEUE=swarm-control
SWARMCORE_NATS_URL=nats://localhost:4222
SWARMCORE_NATS_STREAM_REPLICAS=1
SWARMCORE_OTLP_ENDPOINT=http://localhost:4317
SWARMCORE_TELEMETRY_ENABLED=true
SWARMCORE_CAPABILITY_CENTER_V2=true
SWARMCORE_ENVIRONMENT=development
SWARMCORE_AGENT_READINESS_URL=http://localhost:8094
SWARMCORE_AGENT_READINESS_HOST=127.0.0.1
SWARMCORE_AGENT_READINESS_PORT=8094
SWARMCORE_READINESS_TIMEOUT_SECONDS=2
SWARMCORE_RECONCILER_DATABASE_URL=postgresql+asyncpg://swarmcore:swarmcore@localhost:5433/swarmcore
SWARMCORE_PHOENIX_ENDPOINT=http://localhost:6006
SWARMCORE_USE_FAKE_AGENT=false
SWARMCORE_GITHUB_TOKEN=
SWARMCORE_GITHUB_API_URL=https://api.github.com
# HTTPS hosts that supplier-risk tools may call. Provider credentials belong in Vault
# and are referenced from case riskSources with {"secretRef":"secret://..."}.
SWARMCORE_SUPPLIER_RISK_ALLOWED_HOSTS=www.ccgp.gov.cn,api.qichacha.com,open.api.tianyancha.com
SWARMCORE_SUPPLIER_RISK_TIMEOUT_SECONDS=30
# Requires a purpose-built image containing swarmcore-repository-verify and a digest pin.
SWARMCORE_CALIBRATION_SANDBOX_ENABLED=false
SWARMCORE_CALIBRATION_SANDBOX_IMAGE=
SWARMCORE_CALIBRATION_SANDBOX_DOCKER_BINARY=docker
SWARMCORE_CALIBRATION_SANDBOX_TIMEOUT_SECONDS=600
# Logical→provider model names for Model Gateway / worker fallback. Prefer project
# models (model://project/{uuid}) created in 模型广场 for agent bindings; keep these
# routes aligned so built-in agents that still declare model://general etc. resolve.
SWARMCORE_MODELS={"model://general":"DeepSeek-V4-Pro","model://document-nlp":"DeepSeek-V4-Pro","model://contract-performance-reasoning":"DeepSeek-V4-Pro","model://document-vision-fallback":"DeepSeek-V4-Pro","model://deepseek-v4-flash":"DeepSeek-V4-Pro","model://deepseek-v4-pro":"DeepSeek-V4-Pro","model://kimi-k2.5":"kimi-k2.5","model://kimi-k2.7-code":"kimi-k2.7-code","model://calibration-primary":"kimi-k2.7-code","model://calibration-review":"DeepSeek-V4-Pro","model://calibration-standby":"kimi-k2.5"}
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://gateway.ontomind.net/v1
# OpenAI-compatible base (…/v1) or portal capability invoke URL ending in
# /openapi/capabilities/<capability-id>/invoke. Pair with SWARMCORE_MODEL_ROUTES.
# Local direct connect: leave SWARMCORE_VAULT_TOKEN empty so readiness skips Vault lease.
SWARMCORE_MODEL_PROVIDER_URL=https://gateway.ontomind.net/v1
SWARMCORE_MODEL_PROVIDER_API_KEY=
SWARMCORE_TOOL_CAPABILITY_SECRET=replace-with-at-least-32-random-bytes
SWARMCORE_TOOL_GATEWAY_URL=http://localhost:8090
SWARMCORE_TOOL_GATEWAY_HOST=127.0.0.1
SWARMCORE_TOOL_GATEWAY_PORT=8090
SWARMCORE_DEPLOYMENT_MODE=local
SWARMCORE_WORKLOAD_TLS_CA_FILE=
SWARMCORE_WORKLOAD_TLS_CERT_FILE=
SWARMCORE_WORKLOAD_TLS_KEY_FILE=
SWARMCORE_AUTH_MODE=local
SWARMCORE_POLICY_MODE=local
SWARMCORE_OPA_DECISION_URL=http://localhost:8181/v1/data/swarmcore/decision
SWARMCORE_VAULT_ADDRESS=http://localhost:8200
SWARMCORE_VAULT_TOKEN=
SWARMCORE_VAULT_KUBERNETES_ROLE=
SWARMCORE_VAULT_KUBERNETES_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
SWARMCORE_VAULT_KUBERNETES_AUTH_MOUNT=kubernetes
SWARMCORE_ARTIFACT_ROOT=.tmp/artifacts
SWARMCORE_ARTIFACT_STORE=local
SWARMCORE_OCR_ENDPOINT=
# Optional JSON-over-HTTP OCR provider. Request fields: mediaType, contentBase64, pages.
# Response fields: text, pages=[{page,text,confidence,blocks}], blocks with bbox and
# confidence, and tables with rows/cells plus page or bbox evidence.
SWARMCORE_OCR_API_KEY=
SWARMCORE_OCR_TIMEOUT_SECONDS=120
# Optional local OCR fallback. Configure absolute executable paths; PDF OCR also needs pdftoppm.
SWARMCORE_TESSERACT_CMD=
SWARMCORE_PDFTOPPM_CMD=
SWARMCORE_PDFTOTEXT_CMD=
SWARMCORE_TESSERACT_LANG=chi_sim+eng
# When neither remote nor local OCR is configured, scans enter REVIEW_REQUIRED.
SWARMCORE_ARTIFACT_GATEWAY_HOST=127.0.0.1
SWARMCORE_ARTIFACT_GATEWAY_PORT=8091
SWARMCORE_ARTIFACT_GATEWAY_URL=http://localhost:8091
SWARMCORE_ARTIFACT_S3_BUCKET=
SWARMCORE_ARTIFACT_S3_ENDPOINT=
SWARMCORE_ARTIFACT_S3_REGION=us-east-1
SWARMCORE_ARTIFACT_S3_KMS_KEY_ID=
SWARMCORE_ARTIFACT_CLAMAV_HOST=
SWARMCORE_WEBHOOK_ALLOWED_HOSTS=[]
SWARMCORE_WEBHOOK_POLL_SECONDS=0.5
SWARMCORE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SWARMCORE_JWT_ISSUER=
SWARMCORE_JWT_AUDIENCE=swarmcore-api
SWARMCORE_JWT_JWKS_URL=
SWARMCORE_ARTIFACT_CAPABILITY_SECRET=replace-with-at-least-32-random-bytes
SWARMCORE_MODEL_CAPABILITY_SECRET=replace-with-at-least-32-random-bytes
SWARMCORE_MODEL_GATEWAY_HOST=127.0.0.1
SWARMCORE_MODEL_GATEWAY_PORT=8093
SWARMCORE_MODEL_GATEWAY_URL=http://localhost:8093
SWARMCORE_MODEL_GATEWAY_TIMEOUT_SECONDS=300
SWARMCORE_AGENT_MODEL_MAX_OUTPUT_TOKENS=8192
SWARMCORE_MODEL_RESERVATION_TTL_SECONDS=360
SWARMCORE_WORKER_MAX_CONCURRENT_WORKFLOWS=100
SWARMCORE_WORKER_MAX_CONCURRENT_ACTIVITIES=32
SWARMCORE_WORKER_MAX_WORKFLOW_POLLS=5
SWARMCORE_WORKER_MAX_ACTIVITY_POLLS=5
# Only logical models listed here are exposed as system routes in capability-center.
# Built-in registry definitions remain for tests/packs; omit a route to hide it locally.
# When the project has 模型广场 entries, agent/strategy pickers prefer those instead.
# Example (OntoMind gateway model names; put credentials in Vault / model-provider UI):
# {"model://general":"DeepSeek-V4-Pro","model://kimi-k2.7-code":"kimi-k2.7-code"}
SWARMCORE_MODEL_ROUTES={}
SWARMCORE_MODEL_PRICE_VERSION=local-price:v1
# Conservative fail-safe pricing used when a provider omits response_cost.
SWARMCORE_UNPRICED_MODEL_INPUT_USD_PER_MILLION=10
SWARMCORE_UNPRICED_MODEL_OUTPUT_USD_PER_MILLION=30
SWARMCORE_LITELLM_URL=http://localhost:4000
SWARMCORE_LITELLM_TIMEOUT_SECONDS=300
SWARMCORE_LITELLM_SECRET_REF=secret://platform/litellm
SWARMCORE_SANDBOX_CAPABILITY_SECRET=replace-with-at-least-32-random-bytes
SWARMCORE_SANDBOX_HOST=127.0.0.1
SWARMCORE_SANDBOX_PORT=8092
SWARMCORE_SANDBOX_ALLOWED_IMAGES=[]
SWARMCORE_SANDBOX_DRY_RUN=true
# Controlled filesystem tools (tool://filesystem/*). Default fail-closed.
# local mode is for development/test only; production must use sandbox.
SWARMCORE_FILESYSTEM_TOOLS_ENABLED=false
SWARMCORE_FILESYSTEM_ROOT=.tmp/filesystem
SWARMCORE_FILESYSTEM_ALLOWED_MOUNTS=workspace
SWARMCORE_FILESYSTEM_MAX_READ_BYTES=1048576
SWARMCORE_FILESYSTEM_MAX_WRITE_BYTES=1048576
SWARMCORE_FILESYSTEM_MAX_LIST_ENTRIES=1000
SWARMCORE_FILESYSTEM_EXECUTOR_MODE=disabled
SWARMCORE_FILESYSTEM_SANDBOX_URL=http://localhost:8092
SWARMCORE_FILESYSTEM_SANDBOX_IMAGE=
SWARMCORE_FILESYSTEM_SANDBOX_CAPABILITY_SECRET=
SWARMCORE_FILESYSTEM_SANDBOX_TIMEOUT_SECONDS=60
