{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://document-structuring/package@1",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "reviewRequired",
    "documents",
    "crossFormatConsistency",
    "qualityFlags",
    "provenance",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {"const": "schema://document-structuring/package@1"},
    "status": {"enum": ["READY", "REVIEW_REQUIRED"]},
    "reviewRequired": {"type": "boolean"},
    "documents": {"type": "array", "items": {"type": "object"}},
    "crossFormatConsistency": {"type": "object"},
    "summary": {"type": "string"},
    "qualityFlags": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
