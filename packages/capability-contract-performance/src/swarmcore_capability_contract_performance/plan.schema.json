{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://contract-performance/plan@1",
  "type": "object",
  "required": [
    "schemaVersion", "status", "timezone", "currency", "contract", "obligations",
    "deliverables", "milestones", "acceptanceCriteria", "serviceLevels",
    "paymentConditions", "changes", "conflicts", "gaps", "planHash"
  ],
  "properties": {
    "schemaVersion": {"const": "schema://contract-performance/plan@1"},
    "status": {"enum": ["DRAFT", "CANDIDATE", "REVIEW_REQUIRED", "PUBLISHED", "SUPERSEDED"]},
    "timezone": {"type": "string"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "contract": {"type": "object"},
    "obligations": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/obligation"}},
    "deliverables": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
    "milestones": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/milestone"}},
    "acceptanceCriteria": {"type": "array", "items": {"type": "object"}},
    "serviceLevels": {"type": "array", "items": {"type": "object"}},
    "paymentConditions": {"type": "array", "items": {"type": "object"}},
    "changes": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "planHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "required": ["id", "title", "evidenceRefs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "evidenceRefs": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "milestone": {
      "type": "object",
      "required": ["id", "dependencies", "paymentConditionIds", "acceptanceCriterionIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "dueDate": {"type": ["string", "null"], "format": "date"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "paymentConditionIds": {"type": "array", "items": {"type": "string"}},
        "acceptanceCriterionIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
