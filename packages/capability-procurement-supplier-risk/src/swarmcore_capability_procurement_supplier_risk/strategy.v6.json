{
  "apiVersion": "swarmcore.io/v1",
  "kind": "SwarmStrategy",
  "metadata": {"name": "procurement-supplier-risk-assess-v6"},
  "spec": {
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": "object"},
    "defaults": {
      "timeout": "PT10M",
      "retryPolicy": {
        "maxAttempts": 3,
        "initialInterval": "PT1S",
        "maximumInterval": "PT30S",
        "backoffCoefficient": 2
      }
    },
    "budget": {
      "maxDuration": "PT20M",
      "maxTokens": 80000,
      "maxCostUsd": 1.5,
      "maxAgents": 4,
      "maxParallelism": 4,
      "onExhausted": "wait_for_budget_approval"
    },
    "agents": {
      "clause-analyst": {"ref": "agent://procurement/clause-evidence-analyst@4"}
    },
    "graph": {
      "entrypoint": "read-documents",
      "nodes": {
        "read-documents": {
          "type": "tool",
          "tool": "tool://document/read-versions@1",
          "input": {"evaluationId": "{{ input.evaluationId }}", "documents": "{{ input.documents }}"}
        },
        "coverage-check": {
          "type": "tool",
          "tool": "tool://document/coverage-check@1",
          "dependsOn": ["read-documents"],
          "input": {
            "documents": "{{ tasks.read-documents.output.content.documents }}",
            "requirements": [
              {"key": "tender-document", "category": "TENDER_DOCUMENT", "required": true, "minCount": 1, "maxCount": 20},
              {"key": "winning-bid", "category": "WINNING_BID", "required": true, "minCount": 1, "maxCount": 20},
              {"key": "award-notice", "category": "AWARD_NOTICE", "required": true, "minCount": 1, "maxCount": 5},
              {"key": "contract", "category": "MASTER_CONTRACT", "required": true, "minCount": 1, "maxCount": 5}
            ]
          }
        },
        "search-clauses": {
          "type": "tool",
          "tool": "tool://evidence/search@1",
          "dependsOn": ["read-documents"],
          "input": {
            "documents": "{{ tasks.read-documents.output.content.documents }}",
            "domain": "procurement",
            "maxHits": 50
          }
        },
        "clause-analysis": {
          "type": "agent",
          "agent": "clause-analyst",
          "dependsOn": ["coverage-check", "search-clauses"],
          "input": {
            "_contextMode": "node_only",
            "supplier": "{{ input.payload.supplier }}",
            "evidence": "{{ tasks.search-clauses.output.content }}",
            "providedClauseFacts": "{{ input.payload.clauseFacts }}",
            "providedMappingCandidates": "{{ input.payload.mappingCandidates }}"
          }
        },
        "schema-validate": {
          "type": "tool",
          "tool": "tool://agent-output/schema-validate@1",
          "dependsOn": ["clause-analysis"],
          "input": {
            "agentRef": "agent://procurement/clause-evidence-analyst@4",
            "output": "{{ tasks.clause-analysis.output.content }}"
          }
        },
        "risk-collect": {
          "type": "tool",
          "tool": "tool://supplier/risk-collect@2",
          "dependsOn": ["read-documents"],
          "input": {
            "supplier": "{{ input.payload.supplier }}",
            "sources": "{{ input.payload.riskSources }}",
            "asOf": "{{ input.payload.asOf }}"
          }
        },
        "performance-calculate": {
          "type": "tool",
          "tool": "tool://supplier/performance-calculate@1",
          "dependsOn": ["read-documents"],
          "input": {
            "periodStart": "{{ input.payload.performance.periodStart }}",
            "periodEnd": "{{ input.payload.performance.periodEnd }}",
            "minimumSampleSize": "{{ input.payload.performance.minimumSampleSize }}",
            "records": "{{ input.payload.performance.records }}",
            "ruleVersion": "rule://supplier-performance@1"
          }
        },
        "baseline-resolve": {
          "type": "tool",
          "tool": "tool://procurement/baseline-resolve@1",
          "dependsOn": ["schema-validate"],
          "input": {
            "clauses": "{{ tasks.schema-validate.output.content.clauses }}",
            "ruleVersion": "rule://procurement-baseline@1"
          }
        },
        "consistency-compare": {
          "type": "tool",
          "tool": "tool://procurement/consistency-compare@2",
          "dependsOn": ["baseline-resolve", "schema-validate"],
          "input": {
            "clauses": "{{ tasks.schema-validate.output.content.clauses }}",
            "baseline": "{{ tasks.baseline-resolve.output.content }}",
            "mappingCandidates": "{{ tasks.schema-validate.output.content.mappingCandidates }}",
            "approvedExceptionKeys": "{{ input.payload.approvedExceptionKeys }}",
            "ruleVersion": "rule://procurement-consistency@2"
          }
        },
        "risk-decide": {
          "type": "tool",
          "tool": "tool://supplier/risk-decide@2",
          "dependsOn": ["risk-collect", "performance-calculate"],
          "input": {
            "asOf": "{{ input.payload.asOf }}",
            "riskCollection": "{{ tasks.risk-collect.output.content }}",
            "performance": "{{ tasks.performance-calculate.output.content }}",
            "ruleVersion": "rule://supplier-risk@2"
          }
        },
        "history-diff": {
          "type": "tool",
          "tool": "tool://supplier/history-diff@1",
          "dependsOn": ["risk-decide"],
          "input": {
            "previous": "{{ input.payload.previousSnapshot }}",
            "current": "{{ tasks.risk-decide.output.content }}"
          }
        },
        "evidence-gate": {
          "type": "tool",
          "tool": "tool://procurement/evidence-gate@1",
          "dependsOn": ["coverage-check", "consistency-compare", "risk-decide", "performance-calculate"],
          "input": {
            "coverage": "{{ tasks.coverage-check.output.content }}",
            "consistency": "{{ tasks.consistency-compare.output.content }}",
            "risk": "{{ tasks.risk-decide.output.content }}",
            "performance": "{{ tasks.performance-calculate.output.content }}"
          }
        },
        "review-router": {
          "type": "router",
          "dependsOn": ["evidence-gate"],
          "routes": [
            {"when": "tasks.coverage-check.output.content.reviewRequired == true", "target": "manual-review"},
            {"when": "tasks.consistency-compare.output.content.reviewRequired == true", "target": "manual-review"},
            {"when": "tasks.risk-decide.output.content.reviewRequired == true", "target": "manual-review"},
            {"when": "tasks.evidence-gate.output.content.reviewRequired == true", "target": "manual-review"}
          ],
          "default": "auto-continue"
        },
        "manual-review": {
          "type": "approval",
          "dependsOn": ["review-router"],
          "prompt": "存在重大条款差异、有效禁入、风险数据冲突或证据不足，请按任务类型选择动作。REQUEST_EVIDENCE 将保持 HOLD。",
          "requiredRoles": [
            "procurement_reviewer",
            "legal_reviewer",
            "risk_reviewer",
            "tenant_admin"
          ],
          "requiresDistinctApprover": true,
          "inputSchema": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": {
                "enum": [
                  "CONFIRM_BLOCK",
                  "APPROVE_EXCEPTION",
                  "REQUEST_EVIDENCE",
                  "DISMISS_MISMATCH",
                  "CONFIRM_IDENTITY",
                  "REJECT_EXCEPTION",
                  "SUBMIT_CORRECTION"
                ]
              },
              "taskType": {
                "enum": [
                  "IDENTITY_REVIEW",
                  "SOURCE_FACT_REVIEW",
                  "CLAUSE_MAPPING_REVIEW",
                  "CLAUSE_EXCEPTION_APPROVAL",
                  "EVIDENCE_REQUEST"
                ]
              },
              "comment": {"type": "string"},
              "assignee": {"type": "string"},
              "dueAt": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        },
        "auto-continue": {"type": "join", "strategy": "all", "dependsOn": ["review-router"]},
        "finalize": {
          "type": "tool",
          "tool": "tool://procurement-supplier-risk/finalize@2",
          "dependsOn": ["manual-review", "auto-continue", "evidence-gate", "history-diff"],
          "input": {
            "caseId": "{{ input.workItemId }}",
            "monitorId": "{{ input.payload.monitorId }}",
            "assessmentId": "{{ input.evaluationId }}",
            "asOf": "{{ input.payload.asOf }}",
            "supplier": "{{ input.payload.supplier }}",
            "consistency": "{{ tasks.consistency-compare.output.content }}",
            "risk": "{{ tasks.risk-decide.output.content }}",
            "performance": "{{ tasks.performance-calculate.output.content }}",
            "history": "{{ tasks.history-diff.output.content }}",
            "evidenceGate": "{{ tasks.evidence-gate.output.content }}",
            "approval": "{{ tasks.manual-review.output }}",
            "provenance": {
              "documentContentHash": "{{ tasks.read-documents.output.content.contentHash }}",
              "attachmentManifestHash": "{{ input.attachmentManifestHash }}",
              "selectionManifestHash": "{{ input.selectionManifestHash }}",
              "baselineHash": "{{ input.baselineHash }}",
              "configurationHash": "{{ input.configurationHash }}",
              "strategy": "strategy://procurement-supplier-risk/assess@6",
              "ruleVersions": [
                "rule://procurement-baseline@1",
                "rule://procurement-consistency@2",
                "rule://supplier-risk@2",
                "rule://supplier-performance@1"
              ]
            }
          }
        },
        "report": {
          "type": "tool",
          "tool": "tool://report/render-procurement-supplier-risk@1",
          "dependsOn": ["finalize"],
          "input": {"result": "{{ tasks.finalize.output.content }}"}
        },
        "record": {
          "type": "tool",
          "tool": "tool://workbench/record-procurement-supplier-risk@1",
          "dependsOn": ["finalize", "report"],
          "input": {
            "evaluationId": "{{ input.evaluationId }}",
            "monitorId": "{{ input.payload.monitorId }}",
            "result": "{{ tasks.finalize.output.content }}",
            "report": "{{ tasks.report.output.content }}"
          }
        }
      },
      "output": {"result": "{{ tasks.finalize.output.content }}"}
    },
    "$defs": {}
  }
}
